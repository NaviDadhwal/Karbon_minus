# Clerk Authentication (Google Auth + Email)
# 1. Sign up at https://dashboard.clerk.com
# 2. Under "Configure" -> "SSO Connections", enable "Google"
# 3. Copy API Keys from "API Keys" section:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk URL routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/projects
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/projects

# OpenAI API Key (for carbon alternatives & AI negotiation suggestions)
OPENAI_API_KEY=sk-...
